# Copy this file to .env and paste your key there.
# .env is gitignored so the key is never pushed to GitHub.
# Google AI Studio → https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_KEY_HERE

# Optional: override the vision model (defaults to gemini-2.5-flash)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
