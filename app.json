{
  "expo": {
    "name": "AFD Delivery",
    "slug": "smartdelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#001F3F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aymanefouad.smartdelivery"
    },
    "android": {
      "package": "com.aymanefouad.smartdelivery",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#001F3F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "rn-af-identity-ocr"
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AFD Delivery to access your camera to photograph packages."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7f618367-f384-493b-a374-36a342d11dfc"
      }
    },
    "owner": "aymane_fouad1983"
  }
}
