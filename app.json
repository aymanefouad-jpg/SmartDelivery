{
  "expo": {
    "name": "SmartDelivery",
    "slug": "SmartDelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#001F3F"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aymanefouad.smartdelivery"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["rn-af-identity-ocr"],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AFD Delivery to access your camera to photograph packages."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "07c73c88-d6ce-40d6-a558-c04d70aba2a0"
      }
    }
  }
}